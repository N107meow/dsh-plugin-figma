# dependencies
node_modules/
.pnpm-store/

# build output
#
# ⚠️ lib/ is deliberately NOT ignored.
# This project is distributed via GitHub only (docs/PLAN.md §12.9.1), and
# `pnpm add github:<user>/<repo>` does NOT run a build step. So the compiled
# ESM output must be committed, or users install an empty package.
# `dist/` stays ignored — it is not the published entry point.
dist/
*.tsbuildinfo

# secrets — never commit a Figma token
.env
.env.*
!.env.example
.credentials.yaml
*.token
.secrets/

# test artifacts and recorded Figma fixtures that may contain private file data
fixtures/recorded/
coverage/
*.log

# editor / OS
.DS_Store
.idea/
.vscode/
