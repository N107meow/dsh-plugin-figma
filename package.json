{
  "name": "dsh-plugin-figma",
  "version": "0.1.0",
  "description": "Read-only Figma design-source tools for DeepSeek Harness: inspect file structure, colors, typography and export images as native tools.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "figma",
    "design",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "//peerDependencies": "The host supplies these, but this repo is consumed via `link:`, so Node resolves imports from THIS directory (the symlink's real path). They must therefore be installed here too \u2014 see docs/P0-IMPLEMENTATION.md section 1.0.",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "check:deps": "node scripts/check-deps.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:deps && npm run check:layering && npm run check:secrets && npm test",
    "test": "node --test test/",
    "test:core": "node --test test/core/",
    "test:real": "node --env-file-if-exists=.env.local --test test/core/real-data.test.js test/core/p1-real-data.test.js",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N107meow/dsh-plugin-figma.git"
  },
  "bugs": {
    "url": "https://github.com/N107meow/dsh-plugin-figma/issues"
  },
  "homepage": "https://github.com/N107meow/dsh-plugin-figma#readme"
}
